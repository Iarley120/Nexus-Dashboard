.status-danger {
  color: var(--color-danger);
}

/* 11. Rodapé */
footer {
  padding: 24px 18px;
  color: var(--color-muted);
  text-align: center;
  border-top: 1px solid var(--color-border);
}

/* 12. Telas médias */
@media (max-width: 900px) {
  .card,
  .widget,
  .dashboard-card {
    grid-column: span 6;
  }

  .card-wide,
  .widget-wide,
  .weather-card,
  .task-card {
    grid-column: span 12;
  }

  header,
  .header,
  .dashboard-header {
    align-items: flex-start;
  }
}

/* 13. Celulares */
@media (max-width: 600px) {
  header,
  .header,
  .dashboard-header {
    flex-direction: column;
    padding: 18px;
  }

  main {
    padding: 16px;
  }

  .dashboard,
  .dashboard-grid,
  .cards-container,
  .widgets-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .card,
  .widget,
  .dashboard-card,
  .card-wide,
  .widget-wide,
  .weather-card,
  .task-card,
  .card-full,
  .widget-full {
    grid-column: 1 / -1;
    padding: 18px;
  }

  form {
    flex-direction: column;
  }

  form input,
  form textarea,
  form select,
  form button {
    width: 100%;
  }

  #task-list li,
  #tasks-list li,
  .task-list li,
  .todo-list li,
  .task-item {
    align-items: flex-start;
  }
}

/* 14. Respeita a preferência de movimento reduzido */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
